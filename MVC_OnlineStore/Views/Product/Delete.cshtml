@model MVC_OnlineStore.Models.Product

<h2>Delete Product</h2>

<p>
    Are you sure you want to delete this product?
</p>

<div>
    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Price:</strong>
        @Model.Price
    </p>

    <p>
        <strong>Quantity:</strong>
        @Model.Quantity
    </p>

    <p>
        <strong>Category:</strong>
        @Model.Category.Name
    </p>
</div>

<form asp-action="DeleteConfirmed"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>