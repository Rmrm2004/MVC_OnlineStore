@model IEnumerable<MVC_OnlineStore.Models.Order>

<h2>Orders</h2>

<a asp-action="Create" class="btn btn-primary">
    Create New Order
</a>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Customer Name</th>
            <th>Address</th>
            <th>Order Date</th>
            <th>Total Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Id</td>
                <td>@order.CustomerName</td>
                <td>@order.CustomerAddress</td>
                <td>@order.OrderDate</td>
                <td>@order.TotalPrice</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@order.Id"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@order.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>