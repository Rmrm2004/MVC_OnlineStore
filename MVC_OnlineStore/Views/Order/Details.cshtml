@model MVC_OnlineStore.Models.Order

<h2>Order Details</h2>

<div class="mb-3">
    <p><strong>Order Id:</strong> @Model.Id</p>
    <p><strong>Customer Name:</strong> @Model.CustomerName</p>
    <p><strong>Address:</strong> @Model.CustomerAddress</p>
    <p><strong>Order Date:</strong> @Model.OrderDate</p>
    <p><strong>Total Price:</strong> @Model.TotalPrice</p>
</div>

<h4>Products</h4>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Quantity</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.UnitPrice</td>
                <td>@item.Quantity</td>
                <td>@(item.UnitPrice * item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">
    Back
</a>