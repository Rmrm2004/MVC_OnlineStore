@model MVC_OnlineStore.Models.Category

<h2>Create Category</h2>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="Name"></label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

</form>